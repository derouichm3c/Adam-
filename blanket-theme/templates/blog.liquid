<section class="page-hero"><div class="container"><span class="eyebrow">Journal</span><h1>{{ blog.title }}</h1></div></section>
<section class="page-wrap">
  <div class="container">
    {%- paginate blog.articles by 9 -%}
      <div class="grid-products">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            {%- if article.image -%}<div class="card__media"><img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy" width="700" height="700"></div>{%- endif -%}
            <div class="card__body"><div class="card__title">{{ article.title }}</div><div class="card__price" style="color:var(--muted)">{{ article.published_at | date: '%B %d, %Y' }}</div></div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
