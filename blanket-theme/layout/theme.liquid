<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FAF6F0">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if template.name == 'product' and product.featured_image -%}
    <meta property="og:type" content="product">
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta property="og:type" content="website">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.classList.remove('no-js');
    window.Theme = {
      moneyFormat: {{ shop.money_format | json }},
      freeShipping: {{ settings.free_shipping_threshold | default: 0 | times: 100 }},
      routes: { cartAdd: {{ routes.cart_add_url | append: '.js' | json }}, cartChange: {{ routes.cart_change_url | append: '.js' | json }}, cart: {{ routes.cart_url | append: '.js' | json }} },
      tiers: [
        { qty: 1, pct: 0 },
        { qty: 2, pct: {{ settings.tier2_discount | default: 0 }} },
        { qty: 3, pct: {{ settings.tier3_discount | default: 0 }} }
      ]
    };
  </script>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="visually-hidden" href="#main">Skip to content</a>

  {% section 'header' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <!-- Cart drawer -->
  <div class="drawer" id="cartDrawer" aria-hidden="true">
    <div class="drawer__overlay" data-close-drawer></div>
    <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="Your cart">
      <div class="drawer__head">
        <h3>Your cart</h3>
        <button class="drawer__close" type="button" aria-label="Close cart" data-close-drawer>&times;</button>
      </div>
      {%- if settings.free_shipping_threshold > 0 -%}
        <div class="ship-bar">
          <span id="shipBarText">Free shipping on orders over {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}</span>
          <div class="ship-bar__track"><div class="ship-bar__fill" id="shipBarFill" style="width:0%"></div></div>
        </div>
      {%- endif -%}
      <div class="drawer__items" id="drawerItems">
        <div class="drawer__empty">Your cart is empty.</div>
      </div>
      <div class="drawer__foot" id="drawerFoot" hidden>
        <div class="drawer__row drawer__row--save" id="drawerSaveRow" hidden><span>You save</span><span id="drawerSave"></span></div>
        <div class="drawer__row"><span>Subtotal</span><span id="drawerTotal"></span></div>
        <p class="drawer__note">Taxes and shipping calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--accent btn--lg btn--block">{% render 'icon', name: 'lock' %} Secure checkout</button>
        </form>
      </div>
    </aside>
  </div>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
