[
  {
    "name": "theme_info",
    "theme_name": "Youcef",
    "theme_version": "1.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Store name shown on the site",
        "default": "Youcef"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, 64 x 64 px or larger"
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "paragraph",
        "content": "These photos are shown while your Shopify product has no photos of its own. Best: upload the photos to the product in Shopify Admin."
      },
      {
        "type": "textarea",
        "id": "fallback_photos",
        "label": "Fallback photo links (one per line)",
        "default": "https://s.alicdn.com/@sc01/kf/H37d4bcd1cfd544d6b46cff6f01b27ae2g.jpg\nhttps://s.alicdn.com/@sc01/kf/H7b47a6019be2415eb835621b5a8b07980.jpg\nhttps://s.alicdn.com/@sc01/kf/Hd9a09a32bee5481a9f4be99c1e740397a.jpg\nhttps://s.alicdn.com/@sc01/kf/H764585df1b2343b49ac6a8324fd1e7a2a.jpg\nhttps://s.alicdn.com/@sc01/kf/Hc686d0ab6e684834adf396ee9caf1f3eN.jpg"
      },
      {
        "type": "textarea",
        "id": "color_swatches",
        "label": "Colour swatches (Name:#hex, one per line)",
        "default": "Snow:#EEE9E2\nCocoa:#7A5B45\nAmber:#C9773F\nSand:#D6C2A6"
      }
    ]
  },
  {
    "name": "Offers",
    "settings": [
      {
        "type": "paragraph",
        "content": "These percentages are displayed on the 2 and 3 unit offers. Create the matching automatic discounts in Shopify Admin > Discounts (e.g. 'Buy 2, get 15% off') so the price is really applied at checkout."
      },
      {
        "type": "range",
        "id": "tier2_discount",
        "label": "Discount for 2 units",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 15
      },
      {
        "type": "range",
        "id": "tier3_discount",
        "label": "Discount for 3 units",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 25
      },
      {
        "type": "range",
        "id": "guarantee_days",
        "label": "Guarantee (days)",
        "min": 7,
        "max": 100,
        "step": 1,
        "default": 30
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping progress bar threshold (0 = hidden)",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "$",
        "default": 0
      }
    ]
  }
]