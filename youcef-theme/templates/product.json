    "faq": {
      "type": "faq",
      "settings": {},
      "blocks": {
        "faq_1": {
          "type": "question",
          "settings": {
            "question": "What is it made of?",
            "answer": "<p>95% polyester and 5% spandex: long, rippled faux fur on a heavyweight knitted base. Very warm, while staying soft and easy to care for.</p>"
          }
        },
        "faq_2": {
          "type": "question",
          "settings": {
            "question": "How do I wash it?",
            "answer": "<p>Machine wash cold on a gentle cycle and tumble dry on low. Avoid bleach and fabric softener to keep it extra soft.</p>"
          }
        },
        "faq_3": {
          "type": "question",
          "settings": {
            "question": "Does it shed or pill?",
            "answer": "<p>It has an anti-pilling finish. A first gentle wash before use removes any loose fibres from manufacturing.</p>"
          }
        },
        "faq_4": {
          "type": "question",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "<p>The Throw (40\" × 60\") is perfect for the sofa or an armchair. The Oversized (60\" × 80\") wraps two people or covers a queen bed.</p>"
          }
        },
        "faq_5": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are processed within 1–3 business days. Delivery to Canada and the US usually takes 7–12 business days, with tracking.</p>"
          }
        },
        "faq_6": {
          "type": "question",
          "settings": {
            "question": "What if I don't like it?",
            "answer": "<p>You are covered by our 30-day guarantee. Contact us and we'll make it right.</p>"
          }
        }
