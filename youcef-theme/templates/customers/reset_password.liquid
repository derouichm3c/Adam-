<section class="auth">
  <h1>Reset password</h1>
  <div class="account-block">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="newsletter__msg" style="color:#c0392b">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label for="Pwd">New password</label>
        <input type="password" id="Pwd" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="PwdConfirm">Confirm password</label>
        <input type="password" id="PwdConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--lg btn--block">Reset password</button>
    {%- endform -%}
  </div>
</section>
