{%- comment -%} Fallback product illustration, shown until real product photos are added in Shopify. {%- endcomment -%}
<svg class="illustration" viewBox="0 0 400 400" role="img" aria-label="Stack of soft folded blankets">
  <defs>
    <pattern id="knit" width="14" height="12" patternUnits="userSpaceOnUse">
      <path d="M0 0 L7 6 L14 0 M0 6 L7 12 L14 6" fill="none" stroke="#000" stroke-opacity=".07" stroke-width="2"/>
    </pattern>
    <pattern id="sherpa" width="10" height="10" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="2.2" fill="#fff" fill-opacity=".55"/><circle cx="8" cy="8" r="2.2" fill="#fff" fill-opacity=".45"/>
    </pattern>
  </defs>
  <ellipse cx="200" cy="350" rx="150" ry="14" fill="#2E241C" opacity=".08"/>
  <!-- bottom blanket -->
  <rect x="62" y="262" width="276" height="80" rx="34" fill="#B98A62"/>
  <rect x="62" y="262" width="276" height="80" rx="34" fill="url(#knit)"/>
  <path d="M96 262 v80" stroke="#A47652" stroke-width="3"/>
  <!-- middle blanket -->
  <rect x="74" y="188" width="252" height="80" rx="34" fill="#EFE3D2"/>
  <rect x="74" y="188" width="252" height="80" rx="34" fill="url(#sherpa)"/>
  <path d="M74 236 q126 18 252 0" stroke="#D9C6AB" stroke-width="3" fill="none"/>
  <!-- top blanket -->
  <rect x="86" y="114" width="228" height="80" rx="34" fill="#D7B48E"/>
  <rect x="86" y="114" width="228" height="80" rx="34" fill="url(#knit)"/>
  <path d="M86 162 q114 16 228 0" stroke="#C49C72" stroke-width="3" fill="none"/>
  <!-- tag -->
  <rect x="246" y="128" width="42" height="26" rx="6" fill="#FFF8EF"/>
  <path d="M256 141h22" stroke="#A8683A" stroke-width="3" stroke-linecap="round"/>
  <!-- warmth lines -->
  <g fill="none" stroke="#A8683A" stroke-width="3.5" stroke-linecap="round" opacity=".55">
    <path d="M160 96c-10-12 10-20 0-34"/><path d="M200 92c-10-12 10-20 0-34"/><path d="M240 96c-10-12 10-20 0-34"/>
  </g>
</svg>
