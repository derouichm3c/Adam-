<section class="section section--dark" id="comfort">
  <div class="container layers">
    <div class="layers__visual reveal">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="900" height="900" style="border-radius:14px">
      {%- elsif section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="900" style="border-radius:14px">
      {%- else -%}
        <svg viewBox="0 0 360 360" width="100%" role="img" aria-label="Blanket comfort layers">
          <defs>
            <pattern id="lk" width="14" height="12" patternUnits="userSpaceOnUse"><path d="M0 0 L7 6 L14 0 M0 6 L7 12 L14 6" fill="none" stroke="#000" stroke-opacity=".08" stroke-width="2"/></pattern>
            <pattern id="ls" width="10" height="10" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="2.2" fill="#fff" fill-opacity=".5"/><circle cx="8" cy="8" r="2.2" fill="#fff" fill-opacity=".4"/></pattern>
          </defs>
          <g transform="translate(0 40)">
            <path d="M40 210 L180 270 L320 210 L180 150 Z" fill="#8C6446"/>
            <path d="M40 210 L180 270 L320 210 L180 150 Z" fill="url(#lk)"/>
            <path d="M40 160 L180 220 L320 160 L180 100 Z" fill="#EFE3D2"/>
            <path d="M40 160 L180 220 L320 160 L180 100 Z" fill="url(#ls)"/>
            <path d="M40 110 L180 170 L320 110 L180 50 Z" fill="#D7B48E"/>
            <path d="M40 110 L180 170 L320 110 L180 50 Z" fill="url(#lk)"/>
            <g fill="#E9C9A6" font-family="Arial,sans-serif" font-weight="700" font-size="15">
              <circle cx="330" cy="70" r="14"/><text x="330" y="75" text-anchor="middle" fill="#2E241C">1</text>
              <circle cx="330" cy="140" r="14"/><text x="330" y="145" text-anchor="middle" fill="#2E241C">2</text>
              <circle cx="330" cy="210" r="14"/><text x="330" y="215" text-anchor="middle" fill="#2E241C">3</text>
            </g>
            <g fill="none" stroke="#E9C9A6" stroke-width="3" stroke-linecap="round" opacity=".7">
              <path d="M150 30c-8-10 8-16 0-28"/><path d="M180 26c-8-10 8-16 0-28"/><path d="M210 30c-8-10 8-16 0-28"/>
            </g>
          </g>
        </svg>
      {%- endif -%}
    </div>
    <div>
      <div class="reveal">
        <span class="eyebrow" style="color:#E9C9A6">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p style="color:#D9CBB9;margin-bottom:1.8rem">{{ section.settings.text }}</p>
      </div>
      <div class="layers__list">
        {%- for block in section.blocks -%}
          <div class="layer reveal" {{ block.shopify_attributes }}>
            <span class="layer__num">{{ forloop.index }}</span>
            <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comfort layers",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "image_url", "label": "Or image link", "default": "https://s.alicdn.com/@sc01/kf/H7b47a6019be2415eb835621b5a8b07980.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Crafted for comfort" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Waves of softness, layer after layer" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Long, wave-shaped faux fur on a knitted base with an anti-pilling finish — cozy through every season and easy to wash." }
  ],
  "blocks": [
    { "type": "layer", "name": "Layer", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Velvety top" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Silky-smooth against your skin." }
    ] }
  ],
  "presets": [{ "name": "Comfort layers", "blocks": [
    { "type": "layer", "settings": { "title": "Rippled faux-fur top", "text": "Long, wave-shaped fibres with a plush, silky touch you will want to sink into." } },
    { "type": "layer", "settings": { "title": "Heavyweight knitted base", "text": "A dense, high-weight base that holds your body heat in on cold nights." } },
    { "type": "layer", "settings": { "title": "Anti-pilling finish", "text": "Treated to resist pilling, so it keeps looking beautiful wash after wash." } }
  ] }]
}
{% endschema %}
