<section class="section" id="sizes">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="sizes reveal">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col">{{ section.settings.size1_name }}<small>{{ section.settings.size1_dims }}</small></th>
            <th scope="col">{{ section.settings.size2_name }}<small>{{ section.settings.size2_dims }}</small></th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.label }}</td>
              <td>{%- case block.settings.value1 -%}{%- when 'yes' -%}<span class="yes" aria-label="Yes">{% render 'icon', name: 'check' %}</span>{%- when 'no' -%}<span class="no" aria-label="No">{% render 'icon', name: 'x' %}</span>{%- else -%}{{ block.settings.value1 }}{%- endcase -%}</td>
              <td>{%- case block.settings.value2 -%}{%- when 'yes' -%}<span class="yes" aria-label="Yes">{% render 'icon', name: 'check' %}</span>{%- when 'no' -%}<span class="no" aria-label="No">{% render 'icon', name: 'x' %}</span>{%- else -%}{{ block.settings.value2 }}{%- endcase -%}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Size guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare sizes" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two sizes of the same throw. Pick the one that fits how you curl up." },
    { "type": "text", "id": "size1_name", "label": "Size 1 name", "default": "Throw" },
    { "type": "text", "id": "size1_dims", "label": "Size 1 dimensions", "default": "40\" × 60\" (100 × 150 cm)" },
    { "type": "text", "id": "size2_name", "label": "Size 2 name", "default": "Oversized" },
    { "type": "text", "id": "size2_dims", "label": "Size 2 dimensions", "default": "60\" × 80\" (150 × 200 cm)" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Best for" },
      { "type": "text", "id": "value1", "label": "Size 1 (type yes / no for icons)", "default": "yes" },
      { "type": "text", "id": "value2", "label": "Size 2 (type yes / no for icons)", "default": "yes" }
    ] }
  ],
  "presets": [{ "name": "Size guide", "blocks": [
    { "type": "row", "settings": { "label": "Best for", "value1": "Sofa, armchair, one person", "value2": "Two people, queen bed" } },
    { "type": "row", "settings": { "label": "Colours", "value1": "4 colours", "value2": "4 colours" } },
    { "type": "row", "settings": { "label": "Anti-pilling", "value1": "yes", "value2": "yes" } },
    { "type": "row", "settings": { "label": "Machine washable", "value1": "yes", "value2": "yes" } },
    { "type": "row", "settings": { "label": "Covers a bed", "value1": "no", "value2": "yes" } }
  ] }]
}
{% endschema %}
