{%- comment -%}
  Only add genuine customer reviews here. The section stays hidden until at least one review is added.
  Tip: you can also install a review app (Judge.me, Loox...) and add its app block instead.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section section--cream" id="reviews">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'review' -%}
            <article class="review reveal" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="Customer photo" loading="lazy" width="600" height="600">{%- endif -%}
              <span class="stars" aria-label="{{ block.settings.stars }} out of 5">{% for i in (1..block.settings.stars) %}&#9733;{% endfor %}</span>
              <p class="review__text">{{ block.settings.text }}</p>
              <div class="review__author">{{ block.settings.name }}{% if block.settings.verified %}<span>&#10003; Verified buyer</span>{% endif %}</div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "paragraph", "content": "Add only genuine customer reviews. The section is hidden while empty." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer love" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "image", "label": "Customer photo (optional)" },
      { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Review" },
      { "type": "text", "id": "name", "label": "Name (e.g. Sarah M.)" },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
    ] }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
