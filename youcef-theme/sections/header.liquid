{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
{%- if section.settings.show_announcement -%}
<div class="announcement" role="region" aria-label="Announcements">
  <div class="announcement__track">
    {%- for n in (1..2) -%}
      {%- for i in (1..4) -%}
        {%- capture key -%}announcement_{{ i }}{%- endcapture -%}
        {%- assign text = section.settings[key] -%}
        {%- if text != blank -%}
          <span {% if n == 2 %}aria-hidden="true"{% endif %}>&#10022; {{ text }}</span>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

<header class="header">
  <div class="container header__inner">
    <button class="icon-btn nav-toggle" type="button" aria-label="Open menu" data-open-nav>{% render 'icon', name: 'menu' %}</button>

    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ settings.brand_name | default: shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ settings.brand_name | default: shop.name }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" style="height:{{ section.settings.logo_height }}px;width:auto">
      {%- else -%}
        {% render 'icon', name: 'logo' %}<span>{{ settings.brand_name | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="Main">
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}">Shop</a>
        <a href="{{ routes.root_url }}#comfort">Why it's cozy</a>
        <a href="{{ routes.root_url }}#faq">FAQ</a>
      {%- endif -%}
    </nav>

    <div class="header__actions">
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart" data-open-drawer>
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobileNav">
  <div class="mobile-nav__overlay" data-close-nav></div>
  <nav class="mobile-nav__panel" aria-label="Mobile">
    <button class="mobile-nav__close" type="button" aria-label="Close menu" data-close-nav>&times;</button>
    {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    {%- else -%}
      <a href="{{ routes.root_url }}">Shop</a>
      <a href="{{ routes.root_url }}#comfort">Why it's cozy</a>
      <a href="{{ routes.root_url }}#faq">FAQ</a>
    {%- endif -%}
    {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">Account</a>{%- endif -%}
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (optional — store name is shown if empty)" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 70, "step": 2, "unit": "px", "default": 36 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "announcement_1", "label": "Announcement 1", "default": "Free shipping across Canada & the US" },
    { "type": "text", "id": "announcement_2", "label": "Announcement 2", "default": "30-day money-back guarantee" },
    { "type": "text", "id": "announcement_3", "label": "Announcement 3", "default": "The perfect gift for cold nights" },
    { "type": "text", "id": "announcement_4", "label": "Announcement 4", "default": "Cloud-soft comfort, machine washable" }
  ]
}
{% endschema %}
