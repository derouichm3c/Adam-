<section class="section" id="faq">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="faq accordion reveal">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need to know" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How do I wash it?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Machine wash cold on a gentle cycle and tumble dry low.</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ", "blocks": [
    { "type": "question", "settings": { "question": "How warm is it?", "answer": "<p>Very! The plush fibres trap your body heat, so you feel warm quickly — while staying breathable enough to avoid overheating.</p>" } },
    { "type": "question", "settings": { "question": "How do I wash it?", "answer": "<p>Machine wash cold on a gentle cycle and tumble dry on low. Avoid bleach and fabric softener to keep it extra soft.</p>" } },
    { "type": "question", "settings": { "question": "Does it shed or pill?", "answer": "<p>It is made to resist shedding and pilling. A first wash before use removes any loose fibres from manufacturing.</p>" } },
    { "type": "question", "settings": { "question": "Which size should I choose?", "answer": "<p>Smaller sizes are perfect for the sofa and as a throw; larger sizes cover a bed or two people comfortably. See the sizes in the product selector.</p>" } },
    { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders are processed within 1–3 business days. Delivery to Canada and the US usually takes 7–12 business days, with tracking.</p>" } },
    { "type": "question", "settings": { "question": "What if I don't like it?", "answer": "<p>You are covered by our 30-day guarantee. Contact us and we'll make it right.</p>" } }
  ] }]
}
{% endschema %}
