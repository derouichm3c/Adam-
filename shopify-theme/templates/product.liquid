{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign badge = ''
  assign rating = ''
  assign reviews = ''
  case product.handle
    when 'teeth-whitening-strips'
      assign badge = 'Bestseller'
      assign rating = '4.8'
      assign reviews = '87'
    when 'charcoal-whitening-toothpaste'
      assign badge = 'Natural'
      assign rating = '4.9'
      assign reviews = '168'
    when 'bamboo-toothbrush-4-pack'
      assign badge = 'Eco'
      assign rating = '4.7'
      assign reviews = '96'
    when 'the-complete-smile-bundle'
      assign badge = 'Best value'
      assign rating = '5.0'
      assign reviews = '214'
  endcase
-%}
<section class="product">
  <div class="container product__grid">
    <div class="product__gallery">
      {%- comment -%} Gallery shows images only; videos live in the "How to use it" section below. {%- endcomment -%}
      {%- assign first_img = null -%}
      {%- assign img_count = 0 -%}
      {%- for m in product.media -%}
        {%- if m.media_type == 'image' -%}
          {%- if first_img == null -%}{%- assign first_img = m -%}{%- endif -%}
          {%- assign img_count = img_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="product__main-img" id="pMainStage">
        {%- if first_img -%}
          <img id="pMainImg" src="{{ first_img | image_url: width: 1200 }}" alt="{{ first_img.alt | default: product.title | escape }}" width="600" height="600">
        {%- else -%}
          <img id="pMainImg" src="{{ 'product-1' | placeholder_svg_tag }}" alt="{{ product.title | escape }}" width="600" height="600">
        {%- endif -%}
      </div>

      {%- if img_count > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <a href="#" class="pthumb" data-ptype="image" data-pimg="{{ media | image_url: width: 1200 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 160 }}" alt="{{ product.title | escape }} view {{ forloop.index }}" width="72" height="72" loading="lazy">
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if badge != blank -%}<span class="eyebrow">{{ badge }}</span>{%- endif -%}
      <h1>{{ product.title }}</h1>
      {%- if rating != blank -%}
        <div class="product__stars"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span>{{ rating }} &middot; {{ reviews }} reviews</span></div>
      {%- endif -%}
      <div class="product__price">
        <span class="price-now">{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="price-was">{{ current_variant.compare_at_price | money }}</span>
          <span class="price-save">Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <div class="product__desc rte">{{ product.description }}</div>

      {%- form 'product', product, class: 'product__form' -%}
        {%- if product.variants.size > 1 -%}
          <div class="field">
            <label for="variant-select">Option</label>
            <select id="variant-select" name="id" class="qty-select" style="padding:.6em 1em;border-radius:12px">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} &ndash; {{ variant.price | money }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endif -%}

        <div class="qty-select" aria-label="Quantity">
          <button type="button" data-qty-dec aria-label="Decrease quantity">&minus;</button>
          <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
          <button type="button" data-qty-inc aria-label="Increase quantity">+</button>
        </div>

        {%- if current_variant.available -%}
          <button type="submit" name="add" class="btn btn--primary btn--lg btn--block">Add to cart &middot; {{ current_variant.price | money }}</button>
        {%- else -%}
          <button type="button" class="btn btn--primary btn--lg btn--block" disabled>Sold out</button>
        {%- endif -%}
      {%- endform -%}

      <ul class="product__reassure" style="list-style:none;padding-left:0">
        <li><svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Free tracked shipping on all orders</li>
        <li><svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> 30-day money-back guarantee</li>
        <li><svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Peroxide-free &amp; enamel-safe</li>
      </ul>
    </div>
  </div>
</section>

{%- comment -%} Before / after slider — visible whitening proof {%- endcomment -%}
<section class="ba">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Real results</span>
      <h2>See the difference</h2>
      <p>Drag the slider &mdash; a visibly brighter smile in as little as 7 days.</p>
    </div>
    <div class="ba__wrap" data-ba style="--pos:50%">
      <img class="ba__img ba__after" src="https://cdn.shopify.com/s/files/1/0832/7469/4871/files/hf_20260720_053245_e0d01d16-2a31-4e4e-8849-bfc075c952d1.png?v=1784525662" alt="Smile after whitening" width="1000" height="1000" loading="lazy">
      <img class="ba__img ba__before" src="https://cdn.shopify.com/s/files/1/0832/7469/4871/files/hf_20260720_053329_2edc52bb-0741-4d71-bf97-cdf90e5860d3.png?v=1784525662" alt="Smile before whitening" width="1000" height="1000" loading="lazy">
      <span class="ba__tag ba__tag--before">Before</span>
      <span class="ba__tag ba__tag--after">After</span>
      <button class="ba__handle" type="button" data-ba-handle aria-label="Drag to compare before and after">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 4 12l5 6M15 6l5 6-5 6"/></svg>
      </button>
    </div>
  </div>
</section>
<style>
  .ba{padding-block:clamp(1.5rem,4vw,3rem);}
  .ba__wrap{position:relative;max-width:520px;margin:24px auto 0;aspect-ratio:1/1;border-radius:20px;overflow:hidden;box-shadow:0 20px 44px rgba(11,61,52,.14);background:var(--mint-100,#E8F5F0);user-select:none;-webkit-user-select:none;touch-action:pan-y;cursor:ew-resize;}
  .ba__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;-webkit-user-drag:none;}
  .ba__before{clip-path:inset(0 calc(100% - var(--pos)) 0 0);}
  .ba__tag{position:absolute;top:14px;font-family:'Inter',system-ui,sans-serif;font-size:.64rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:rgba(20,33,29,.5);padding:5px 11px;border-radius:999px;pointer-events:none;z-index:2;}
  .ba__tag--before{left:14px;}
  .ba__tag--after{right:14px;}
  .ba__handle{position:absolute;top:0;bottom:0;left:var(--pos);width:46px;transform:translateX(-50%);background:transparent;border:none;padding:0;cursor:ew-resize;display:grid;place-items:center;z-index:3;}
  .ba__handle::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:3px;transform:translateX(-50%);background:#fff;box-shadow:0 0 0 1px rgba(11,61,52,.12);}
  .ba__handle svg{position:relative;width:38px;height:38px;padding:9px;border-radius:50%;background:#fff;color:var(--green-700,#0A745B);box-shadow:0 6px 18px rgba(11,61,52,.30);}
  @media (max-width:520px){.ba__wrap{max-width:100%;}}
</style>
<script>
  (function(){
    var wrap=document.querySelector('[data-ba]');
    if(!wrap||wrap.dataset.baInit){return;} wrap.dataset.baInit='1';
    var dragging=false;
    function setPos(x){
      var r=wrap.getBoundingClientRect();
      var p=(x-r.left)/r.width*100;
      p=Math.max(0,Math.min(100,p));
      wrap.style.setProperty('--pos',p+'%');
    }
    function pt(e){return e.touches&&e.touches[0]?e.touches[0].clientX:e.clientX;}
    function down(e){dragging=true;setPos(pt(e));if(e.cancelable){e.preventDefault();}}
    function move(e){if(!dragging){return;}setPos(pt(e));if(e.cancelable){e.preventDefault();}}
    function up(){dragging=false;}
    wrap.addEventListener('mousedown',down);
    wrap.addEventListener('touchstart',down,{passive:false});
    window.addEventListener('mousemove',move);
    window.addEventListener('touchmove',move,{passive:false});
    window.addEventListener('mouseup',up);
    window.addEventListener('touchend',up);
  })();
</script>

{%- comment -%}
  Product videos section — shows the product's video(s) so shoppers can see
  what it looks like and how to use it. Renders whenever the product has at
  least one video; otherwise it is hidden automatically.
{%- endcomment -%}
{%- assign pv_video_count = 0 -%}
{%- for m in product.media -%}
  {%- if m.media_type == 'video' -%}{%- assign pv_video_count = pv_video_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if pv_video_count > 0 -%}
  <section class="product-videos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">See it in action</span>
        <h2>How to use it</h2>
      </div>
      <div class="product-videos__carousel{% if pv_video_count == 1 %} is-single{% endif %}" data-pv-carousel>
        <button class="pv-arrow pv-arrow--prev" type="button" aria-label="Previous video" data-pv-prev hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <div class="product-videos__track" data-pv-track>
          {%- assign pv_i = 0 -%}
          {%- for m in product.media -%}
            {%- if m.media_type == 'video' -%}
              {%- assign pv_i = pv_i | plus: 1 -%}
              <button class="pv-item{% if pv_i == pv_video_count %} is-last{% endif %}" type="button" data-pv-item aria-label="Play video {{ pv_i }}">
                <video class="pv-video" loop playsinline preload="metadata" poster="{{ m.preview_image | image_url: width: 800 }}">
                  {%- for source in m.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
                <span class="pv-item__shade" aria-hidden="true"></span>
                <span class="pv-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button class="pv-arrow pv-arrow--next" type="button" aria-label="Next video" data-pv-next>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </section>
  <style>
    .product-videos{padding-block:clamp(1.5rem,4vw,2.75rem);}
    .product-videos .section-head{margin-bottom:0;}
    .product-videos__carousel{position:relative;margin-top:24px;}
    .product-videos__track{
      display:flex;
      align-items:flex-start;
      gap:18px;
      overflow-x:auto;
      scroll-snap-type:x mandatory;
      scroll-behavior:smooth;
      -webkit-overflow-scrolling:touch;
      padding:8px 2px;
      scrollbar-width:none;
    }
    .product-videos__track::-webkit-scrollbar{display:none;}
    .product-videos__carousel.is-single .product-videos__track{justify-content:center;}
    .pv-item{
      position:relative;
      flex:0 0 auto;
      width:290px;
      aspect-ratio:1/1;
      scroll-snap-align:start;
      border:none;
      padding:0;
      margin:0;
      cursor:pointer;
      border-radius:20px;
      overflow:hidden;
      background:#0d0d0d;
      box-shadow:0 18px 40px rgba(11,61,52,.14);
      transition:transform .28s ease,box-shadow .28s ease;
      -webkit-appearance:none;
      appearance:none;
    }
    .pv-item:hover{transform:translateY(-4px);box-shadow:0 26px 54px rgba(11,61,52,.20);}
    .pv-video{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
      transform:scale(1.14);
      transform-origin:center top;
    }
    .pv-item.is-last .pv-video{transform:scale(1.42);transform-origin:center;}
    .pv-item__shade{
      position:absolute;
      inset:0;
      pointer-events:none;
      background:linear-gradient(180deg,rgba(9,58,46,.16),rgba(9,58,46,0) 42%);
      transition:opacity .3s ease;
    }
    .pv-play{
      position:absolute;
      left:50%;
      top:50%;
      transform:translate(-50%,-50%);
      width:62px;
      height:62px;
      border-radius:50%;
      background:rgba(255,255,255,.94);
      color:var(--green-700,#0A745B);
      display:grid;
      place-items:center;
      padding-left:3px;
      box-shadow:0 10px 26px rgba(11,61,52,.28);
      transition:transform .28s ease,opacity .28s ease,background .2s;
    }
    .pv-item:hover .pv-play{transform:translate(-50%,-50%) scale(1.08);background:#fff;}
    .pv-item.is-playing .pv-item__shade{opacity:0;}
    .pv-item.is-playing .pv-play{opacity:0;transform:translate(-50%,-50%) scale(.75);pointer-events:none;}
    .pv-arrow{
      position:absolute;
      top:50%;
      transform:translateY(-50%);
      z-index:3;
      width:46px;
      height:46px;
      border-radius:50%;
      border:1px solid var(--line,#E7E2D6);
      background:#fff;
      color:var(--green-800,#0A5A44);
      box-shadow:0 10px 26px rgba(11,61,52,.18);
      display:grid;
      place-items:center;
      cursor:pointer;
      transition:background .2s,color .2s,opacity .2s;
    }
    .pv-arrow:hover{background:var(--mint-100,#E8F5F1);color:var(--green-700,#0A745B);}
    .pv-arrow svg{display:block;}
    .pv-arrow--prev{left:-10px;}
    .pv-arrow--next{right:-10px;}
    .pv-arrow[hidden]{display:none;}
    @media (max-width:749px){
      .pv-item{width:220px;border-radius:16px;}
      .pv-play{width:52px;height:52px;}
      .pv-arrow{width:40px;height:40px;}
      .pv-arrow--prev{left:2px;}
      .pv-arrow--next{right:2px;}
    }
  </style>
  <script>
    (function(){
      function init(car){
        if(car.dataset.pvInit){return;}
        car.dataset.pvInit='1';
        var track=car.querySelector('[data-pv-track]');
        var prev=car.querySelector('[data-pv-prev]');
        var next=car.querySelector('[data-pv-next]');
        if(track){
          var step=function(){var it=track.querySelector('.pv-item');return it?it.getBoundingClientRect().width+18:260;};
          var update=function(){
            var max=track.scrollWidth-track.clientWidth-2;
            if(track.scrollWidth<=track.clientWidth+4){if(prev){prev.hidden=true;}if(next){next.hidden=true;}return;}
            if(prev){prev.hidden=track.scrollLeft<=2;}
            if(next){next.hidden=track.scrollLeft>=max;}
          };
          if(prev){prev.addEventListener('click',function(){track.scrollBy({left:-step(),behavior:'smooth'});});}
          if(next){next.addEventListener('click',function(){track.scrollBy({left:step(),behavior:'smooth'});});}
          track.addEventListener('scroll',update,{passive:true});
          window.addEventListener('resize',update);
          setTimeout(update,80);
        }
        var items=car.querySelectorAll('[data-pv-item]');
        var vids=[];
        for(var i=0;i<items.length;i++){
          (function(item){
            var v=item.querySelector('video');
            if(!v){return;}
            vids.push(v);
            item.addEventListener('click',function(){
              if(v.paused){
                for(var j=0;j<vids.length;j++){if(vids[j]!==v){vids[j].pause();}}
                var p=v.play();
                if(p&&p.catch){p.catch(function(){});}
              }else{
                v.pause();
              }
            });
            v.addEventListener('play',function(){item.classList.add('is-playing');});
            v.addEventListener('pause',function(){item.classList.remove('is-playing');});
            v.addEventListener('ended',function(){item.classList.remove('is-playing');});
          })(items[i]);
        }
      }
      var cars=document.querySelectorAll('[data-pv-carousel]');
      for(var i=0;i<cars.length;i++){init(cars[i]);}
    })();
  </script>
{%- endif -%}

{%- comment -%} Related products {%- endcomment -%}
<section style="padding-top:0">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">You may also like</span>
      <h2>Complete your routine</h2>
    </div>
    <div class="product-grid">
      {%- assign shown = 0 -%}
      {%- assign handles = 'teeth-whitening-strips,charcoal-whitening-toothpaste,bamboo-toothbrush-4-pack,the-complete-smile-bundle' | split: ',' -%}
      {%- for h in handles -%}
        {%- assign p = all_products[h] -%}
        {%- if p.id and p.handle != product.handle and shown < 4 -%}
          {% render 'product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
