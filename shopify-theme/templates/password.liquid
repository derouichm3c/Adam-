<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Coming soon</span>
    <h1>{{ shop.name }}</h1>
    <p>{{ page_description | default: 'A brighter, more confident smile — naturally. We are opening soon.' }}</p>
  </div>
</section>
<section class="auth">
  <div class="account-block">
    <h2 style="text-align:center;font-size:1.3rem">Enter store using password</h2>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="newsletter__msg" style="color:#c0392b;text-align:center">Incorrect password. Please try again.</p>
      {%- endif -%}
      <div class="field">
        <label for="Password">Password</label>
        <input type="password" id="Password" name="password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--lg btn--block">Enter</button>
    {%- endform -%}
  </div>
</section>
