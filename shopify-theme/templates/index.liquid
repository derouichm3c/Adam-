{%- liquid
  assign bundle_p = all_products['the-complete-smile-bundle']
  assign cdn = 'https://cdn.shopify.com/s/files/1/0832/7469/4871/files/'
-%}

<!-- Hero -->
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">Gentle. Natural. Effective.</span>
      <h1>Whiter teeth,<br><span class="accent">naturally.</span></h1>
      <p class="hero__lead">Professional-level whitening at home &mdash; without the sensitivity, the mess, or the dentist's price tag. Peroxide-free, enamel-safe, and kind to the planet.</p>
      <div class="hero__cta">
        <a href="/products/the-complete-smile-bundle" class="btn btn--primary btn--lg">Shop the Bundle &middot; Save 25$</a>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline btn--lg">Browse all products</a>
      </div>
      <ul class="hero__badges">
        <li>&#10003; Peroxide-free</li>
        <li>&#10003; Enamel-safe</li>
        <li>&#10003; 7-day results</li>
        <li>&#10003; Natural charcoal</li>
      </ul>
    </div>
    <div class="hero__media">
      <img src="{{ cdn }}hf_20260715_233643_2cbe1c7c-06e0-443e-ae7f-3976a74e6956.png?v=1784159002"
           alt="The LumySmile Complete Smile Bundle — bamboo toothbrush, charcoal toothpaste and peroxide-free whitening strips" width="560" height="560" loading="eager">
      <div class="hero__pill hero__pill--1">7-day visible results</div>
      <div class="hero__pill hero__pill--2">
        <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        Loved by happy smiles
      </div>
    </div>
  </div>
</section>

<!-- Trust bar -->
<section class="trustbar" aria-label="Why shop with us">
  <div class="container trustbar__grid">
    <div class="trustbar__item">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div><strong>Peroxide-free</strong><span>Whitening without the zing</span></div>
    </div>
    <div class="trustbar__item">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4c3 2 5 5 5 8a5 5 0 0 1-10 0c0-3 2-6 5-8Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <div><strong>Enamel-safe</strong><span>Gentle on teeth &amp; gums</span></div>
    </div>
    <div class="trustbar__item">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20c5-1 8-5 8-11-4 0-7 1-8 4-1-3-4-4-8-4 0 6 3 10 8 11Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <div><strong>Eco-friendly</strong><span>Biodegradable bamboo</span></div>
    </div>
    <div class="trustbar__item">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7 10 17l-5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div><strong>30-day guarantee</strong><span>Love it or your money back</span></div>
    </div>
  </div>
</section>

<!-- Featured Bundle -->
<section class="bundle" id="bundle">
  <div class="container bundle__inner">
    <div class="bundle__media">
      <img src="{{ cdn }}hf_20260715_224640_429e08a3-e015-4bec-8aaa-52b2f32d9654.png?v=1784156518"
           alt="The Complete Smile Bundle — toothbrush, toothpaste and whitening strips on a natural stone pedestal" width="620" height="620" loading="lazy">
    </div>
    <div class="bundle__copy">
      <span class="eyebrow">Best value &middot; Most popular</span>
      <h2>The Complete Smile Bundle</h2>
      <p>Everything you need for a brighter, healthier smile &mdash; in one box. Our three best-sellers, together at a better price than buying separately.</p>
      <ul class="bundle__list">
        <li><strong>Bamboo Toothbrush 4-Pack</strong> &mdash; charcoal-infused bristles, biodegradable handle</li>
        <li><strong>Charcoal Toothpaste</strong> &mdash; natural whitening, fluoride-free, gentle on enamel</li>
        <li><strong>Whitening Strips</strong> &mdash; peroxide-free, enamel-safe, visible results in days</li>
      </ul>
      <div class="bundle__price">
        <span class="price-now">59.99$</span>
        <span class="price-was">84.97$</span>
        <span class="price-save">Save 24.98$</span>
      </div>
      {%- if bundle_p.id -%}
        {%- form 'product', bundle_p -%}
          <input type="hidden" name="id" value="{{ bundle_p.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="btn btn--primary btn--lg">Add bundle to cart</button>
        {%- endform -%}
      {%- else -%}
        <a href="/products/the-complete-smile-bundle" class="btn btn--primary btn--lg">Add bundle to cart</a>
      {%- endif -%}
      <p class="bundle__note">&#10022; Free tracked shipping &middot; 30-day money-back guarantee</p>
    </div>
  </div>
</section>

<!-- Reviews -->
<section class="reviews" id="reviews">
  <div class="container">
    <div class="section-head section-head--light">
      <span class="eyebrow">Loved by our community</span>
      <h2>Real smiles, real confidence</h2>
      <p class="reviews__rating"><span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> Rated 4.8/5 by happy customers</p>
    </div>
    <div class="reviews__grid">
      <figure class="review">
        <div class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <blockquote>"Whiter teeth in under a week and zero sensitivity. I've tried the burning strips before &mdash; these are on another level."</blockquote>
        <figcaption>Sarah M. &middot; Verified buyer</figcaption>
      </figure>
      <figure class="review">
        <div class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <blockquote>"The charcoal toothpaste leaves my mouth feeling so clean and fresh. Coffee stains are finally fading."</blockquote>
        <figcaption>James T. &middot; Verified buyer</figcaption>
      </figure>
      <figure class="review">
        <div class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <blockquote>"Love that it's eco-friendly and it actually works. The bundle is such good value &mdash; my whole routine sorted."</blockquote>
        <figcaption>Am&eacute;lie R. &middot; Verified buyer</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="newsletter">
  <div class="container newsletter__inner">
    <div>
      <h2>Get 10% off your first order</h2>
      <p>Join the LumySmile list for smile tips, new drops and subscriber-only offers.</p>
    </div>
    {%- form 'customer', id: 'newsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="newsletterEmail">Email address</label>
      <input type="email" id="newsletterEmail" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
      <button type="submit" class="btn btn--primary">Get my 10% off</button>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__msg" id="newsletterMsg" role="status" aria-live="polite">You're in! Watch your inbox for your 10% off code.</p>
      {%- else -%}
        <p class="newsletter__msg" id="newsletterMsg" role="status" aria-live="polite"></p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
