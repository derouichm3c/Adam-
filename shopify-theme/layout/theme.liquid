<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="theme-color" content="#0A745B">
  <link rel="canonical" href="{{ canonical_url }}">

  <link rel="icon" type="image/png" sizes="512x512" href="https://cdn.shopify.com/s/files/1/0832/7469/4871/files/lumysmile-favicon.png?v=1784305122">
  <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0832/7469/4871/files/lumysmile-favicon.png?v=1784305122">
  <link rel="apple-touch-icon" href="https://cdn.shopify.com/s/files/1/0832/7469/4871/files/lumysmile-favicon.png?v=1784305122">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {{ 'lumysmile.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">

  <div class="announcement" role="region" aria-label="Store announcements">
    <div class="announcement__track">
      {%- assign a1 = settings.announcement_1 | default: 'Free tracked shipping on all orders' -%}
      {%- assign a2 = settings.announcement_2 | default: '30-day money-back guarantee' -%}
      {%- assign a3 = settings.announcement_3 | default: 'Peroxide-free & enamel-safe' -%}
      {%- assign a4 = settings.announcement_4 | default: 'Natural charcoal & bamboo' -%}
      <span>&#10022; {{ a1 }}</span>
      <span>&#10022; {{ a2 }}</span>
      <span>&#10022; {{ a3 }}</span>
      <span>&#10022; {{ a4 }}</span>
      <span aria-hidden="true">&#10022; {{ a1 }}</span>
      <span aria-hidden="true">&#10022; {{ a2 }}</span>
      <span aria-hidden="true">&#10022; {{ a3 }}</span>
      <span aria-hidden="true">&#10022; {{ a4 }}</span>
    </div>
  </div>

  {%- liquid
    assign tpl = template.name
    assign ph = ''
    if page != blank
      assign ph = page.handle
    endif
  -%}

  <header class="header" id="top">
    <div class="container header__inner">
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="primaryNav">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
          <rect x="3" y="5" width="18" height="2.4" rx="1.2" fill="currentColor"></rect>
          <rect x="3" y="10.8" width="18" height="2.4" rx="1.2" fill="currentColor"></rect>
          <rect x="3" y="16.6" width="18" height="2.4" rx="1.2" fill="currentColor"></rect>
        </svg>
      </button>
      <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} home">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="140" style="height:34px;width:auto">
        {%- else -%}
          <svg class="brand__logo" viewBox="0 0 580 180" width="152" height="47" role="img" aria-label="LumySmile">
            <text x="290" y="92" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-weight="600" font-size="76" letter-spacing="-1" fill="#1B211F">Lumy<tspan fill="#0C946F">Smile</tspan></text>
            <path d="M164 124c39 25 213 25 252 0" fill="none" stroke="#14AE8C" stroke-width="10" stroke-linecap="round"/>
            <circle cx="430" cy="118" r="8.5" fill="#7FD9C9"/>
          </svg>
        {%- endif -%}
      </a>
      <nav class="nav" id="primaryNav" aria-label="Primary">
        <div class="nav__head">
          <span class="nav__brand">Lumy<span>Smile</span></span>
          <button class="nav__close" id="navClose" type="button" aria-label="Close menu">&times;</button>
        </div>
        <a href="{{ routes.root_url }}"{% if tpl == 'index' %} aria-current="page"{% endif %}>Home</a>
        <a href="{{ routes.all_products_collection_url }}"{% if tpl == 'collection' or tpl == 'product' or tpl == 'list-collections' %} aria-current="page"{% endif %}>Shop</a>
        <a href="/pages/mission"{% if ph == 'mission' %} aria-current="page"{% endif %}>Our Mission</a>
        <a href="/pages/faq"{% if ph == 'faq' %} aria-current="page"{% endif %}>FAQ</a>
        <a href="/pages/about-us"{% if ph == 'about-us' %} aria-current="page"{% endif %}>About</a>
        <a href="/pages/contact"{% if ph == 'contact' %} aria-current="page"{% endif %}>Contact</a>
      </nav>
      <div class="header__actions">
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost header__shop-btn">Shop now</a>
        <a href="{{ routes.cart_url }}" class="cart-btn" id="cartBtn" aria-label="View cart">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 6h15l-1.5 9h-12L6 6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M6 6 5 3H2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="9" cy="20" r="1.4" fill="currentColor"/>
            <circle cx="17" cy="20" r="1.4" fill="currentColor"/>
          </svg>
          <span class="cart-btn__count{% if cart.item_count > 0 %} is-visible{% endif %}" id="cartCount">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </header>

  <div class="nav-overlay" id="navOverlay" aria-hidden="true"></div>

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  <footer class="footer">
    <div class="container footer__grid">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="brand brand--light" aria-label="{{ shop.name }} home">
          <svg class="brand__logo" viewBox="0 0 580 180" width="152" height="47" role="img" aria-label="LumySmile">
            <text x="290" y="92" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-weight="600" font-size="76" letter-spacing="-1" fill="#FFFFFF">Lumy<tspan fill="#7FD9C9">Smile</tspan></text>
            <path d="M164 124c39 25 213 25 252 0" fill="none" stroke="#14AE8C" stroke-width="10" stroke-linecap="round"/>
            <circle cx="430" cy="118" r="8.5" fill="#CDEDE6"/>
          </svg>
        </a>
        <p>Gentle, natural oral care for a brighter, more confident smile.</p>
      </div>
      <div class="footer__col">
        <h4>Shop</h4>
        <a href="{{ routes.all_products_collection_url }}">All products</a>
        <a href="/products/the-complete-smile-bundle">Complete Bundle</a>
        <a href="/pages/about-us">Reviews</a>
      </div>
      <div class="footer__col">
        <h4>Explore</h4>
        <a href="/pages/mission">Our mission</a>
        <a href="/pages/faq">FAQ</a>
        <a href="/pages/about-us">About us</a>
        <a href="/pages/contact">Contact</a>
      </div>
      <div class="footer__col">
        <h4>If you have any question</h4>
        <a href="mailto:support@lumysmile.com">support@lumysmile.com</a>
        <p class="footer__pay">Secure checkout</p>
        <div class="footer__cards" aria-label="Accepted payment methods">
          <span class="pay pay--visa">VISA</span>
          <span class="pay pay--mc"><svg viewBox="0 0 48 31" width="46" height="30" aria-label="Mastercard"><circle cx="20" cy="15.5" r="8.5" fill="#EB001B"/><circle cx="28" cy="15.5" r="8.5" fill="#F79E1B"/><path d="M24 9.2a8.5 8.5 0 0 0 0 12.6 8.5 8.5 0 0 0 0-12.6z" fill="#FF5F00"/></svg></span>
          <span class="pay pay--amex">AMEX</span>
          <span class="pay pay--pp"><svg viewBox="0 0 48 31" width="46" height="30" aria-label="PayPal"><text x="6" y="20" font-family="Arial, sans-serif" font-style="italic" font-weight="800" font-size="12" class="pp1">Pay</text><text x="27" y="20" font-family="Arial, sans-serif" font-style="italic" font-weight="800" font-size="12" class="pp2">Pal</text></svg></span>
          <span class="pay pay--apple"><svg viewBox="0 0 48 31" width="46" height="30" aria-label="Apple Pay"><path d="M14.6 11.2c.5-.6.8-1.5.7-2.3-.7 0-1.6.5-2.1 1.1-.5.5-.9 1.4-.7 2.2.8.1 1.6-.4 2.1-1zm.8 1.2c-1.2-.1-2.2.7-2.7.7-.6 0-1.4-.6-2.3-.6-1.2 0-2.3.7-2.9 1.8-1.2 2.2-.3 5.4.9 7.2.6.9 1.3 1.8 2.2 1.8.9 0 1.2-.6 2.3-.6 1.1 0 1.3.6 2.3.6 1 0 1.6-.9 2.2-1.7.7-1 1-1.9 1-2-.1 0-1.9-.7-1.9-2.8 0-1.7 1.4-2.5 1.5-2.6-.8-1.2-2.1-1.3-2.5-1.3z" fill="#000"/><text x="23" y="20" font-family="Arial, sans-serif" font-weight="700" font-size="12" fill="#000">Pay</text></svg></span>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <div class="container footer__bottom-inner">
        <p>&copy; <span id="year"></span> {{ shop.name }}. All rights reserved.</p>
        <nav class="footer__legal" aria-label="Legal">
          <a href="/policies/privacy-policy">Privacy</a>
          <a href="/policies/terms-of-service">Terms</a>
          <a href="/pages/shipping-returns">Shipping &amp; Returns</a>
        </nav>
      </div>
    </div>
  </footer>

  {%- comment -%} Cart drawer — opened from the header cart button and on add-to-cart {%- endcomment -%}
  <div class="drawer-overlay" id="cartOverlay" hidden></div>
  <aside class="cart-drawer" id="cartDrawer" aria-label="Shopping cart" aria-hidden="true">
    <div class="cart-drawer__head">
      <h2>Your cart</h2>
      <button class="cart-drawer__close" id="cartClose" type="button" aria-label="Close cart">&times;</button>
    </div>
    <div class="cart-drawer__body" id="cartBody"></div>
    <div class="cart-drawer__foot" id="cartFoot" hidden>
      <p class="cart-ship">&#128230; Free tracked shipping on every order</p>
      <div class="cart-subtotal"><span>Subtotal</span><span id="cartSubtotal"></span></div>
      <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary btn--lg btn--block">Checkout securely</a>
      <p class="cart-note">Shipping &amp; taxes calculated at checkout. 30-day money-back guarantee.</p>
    </div>
  </aside>

  {{ 'lumysmile.js' | asset_url | script_tag }}
</body>
</html>
