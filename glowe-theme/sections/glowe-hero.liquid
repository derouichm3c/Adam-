{% comment %}
  Section contract.
  Full-width hero (cream or black) with a large red headline, price and one call to action.
  Shows the promo headline while the promotion runs, the brand headline otherwise.
  Shows the product photo beside the text (section image, or the product's main photo).
  @example
  <!-- Home page, first section. Choose the LED mask product. -->
{% endcomment %}
{% render 'glowe-styles' %}
{%- liquid
  assign product = section.settings.product
  assign product_url = routes.all_products_collection_url
  if product != blank
    assign product_url = product.url
  endif
  assign promo_active = false
  if section.settings.promo_end != blank
    assign now_s = 'now' | date: '%s' | plus: 0
    assign end_s = section.settings.promo_end | date: '%s' | plus: 0
    if end_s > now_s
      assign promo_active = true
    endif
  endif
-%}
{%- liquid
  assign photo = section.settings.image
  if photo == blank and product != blank
    assign photo = product.featured_image
  endif
  assign variant = product.selected_or_first_available_variant
  assign show_slot = false
  if photo == blank and request.design_mode
    assign show_slot = true
  endif
-%}
<div class="section section--full-width glowe glowe--tone-{{ section.settings.tone }} glowe-hero glowe-hero--{{ section.settings.tone }}{% if photo != blank or show_slot %} glowe-hero--split{% endif %}">
  <div class="glowe__inner glowe-hero__grid">
    {%- if photo != blank -%}
      <a class="glowe-hero__photo" href="{{ product_url }}" tabindex="-1" aria-hidden="true">
        {{
          photo
          | image_url: width: 1400
          | image_tag:
            widths: '500, 700, 900, 1100, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      </a>
    {%- elsif show_slot -%}
      {%- comment -%} Editor-only frame: shows where the mask photo goes until one is added. {%- endcomment -%}
      <div class="glowe-hero__photo glowe-hero__slot">
        {% render 'glowe-icon', name: 'face' %}
        <p><strong>{{ 'glowe.hero.slot_title' | t }}</strong></p>
        <p>{{ 'glowe.hero.slot_text' | t }}</p>
      </div>
    {%- endif -%}
    <div class="glowe-hero__content">
      {%- if promo_active -%}
        <p class="glowe-hero__kicker">{{ 'glowe.hero.promo_kicker' | t }}</p>
        <h1 class="glowe-hero__title">{{ 'glowe.hero.promo_title' | t }}</h1>
      {%- else -%}
        <p class="glowe-hero__kicker">{{ 'glowe.hero.eyebrow' | t }}</p>
        <h1 class="glowe-hero__title">{{ 'glowe.hero.big_title' | t }}</h1>
      {%- endif -%}
      <p class="glowe-hero__sub">{{ 'glowe.hero.big_sub' | t }}</p>
      {%- if variant != blank -%}
        <p class="glowe-hero__price">
          <span class="glowe-hero__now">{{ variant.price | money }}</span>
          {%- if variant.compare_at_price > variant.price -%}
            <s class="glowe-hero__was">{{ variant.compare_at_price | money }}</s>
          {%- endif -%}
        </p>
      {%- endif -%}
      <a class="glowe-btn {% if section.settings.tone == 'black' %}glowe-btn--outline-light{% else %}glowe-btn--red{% endif %}" href="{{ product_url }}">{{ 'glowe.hero.shop' | t }}</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .glowe.glowe-hero {
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  /* 0,5,0 so these beat Horizon's transparent-section rule and the shared tone backgrounds. */
  .shopify-section .section.glowe.glowe-hero.glowe-hero--black {
    background:
      radial-gradient(70% 60% at 50% 45%, rgb(167 0 2 / 0.14) 0%, transparent 70%),
      #0a0808;
  }

  .shopify-section .section.glowe.glowe-hero.glowe-hero--ivory {
    background:
      radial-gradient(60% 70% at 50% 40%, rgb(167 0 2 / 0.06) 0%, transparent 70%),
      var(--g-ivory);
  }

  .glowe-hero--ivory .glowe-hero__kicker {
    color: var(--g-red);
  }

  .glowe-hero--ivory .glowe-hero__title {
    color: var(--g-red);
    text-shadow: none;
  }

  .glowe-hero--ivory .glowe-hero__sub {
    color: var(--g-ink-soft);
  }

  .glowe-hero__grid {
    display: grid;
    align-items: center;
    gap: 24px;
    inline-size: 100%;
    max-inline-size: 1280px;
    margin-inline: auto;
  }

  .glowe-hero--split .glowe-hero__grid {
    padding: 24px 16px 8px;
  }

  @media screen and (min-width: 990px) {
    .glowe-hero--split .glowe-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 56px;
      padding: 48px 40px;
    }

    .glowe-hero--split .glowe-hero__content {
      justify-items: start;
      padding: 0;
      text-align: start;
    }
  }

  .glowe-hero--split .glowe-hero__title {
    font-size: clamp(2.4rem, 1rem + 3.6vw, 4.25rem);
  }

  .glowe-hero__photo {
    display: block;
    overflow: hidden;
    border-radius: 16px;
    background: var(--g-sand);
    aspect-ratio: 1 / 1;
  }

  .glowe-hero__slot {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    padding: 24px;
    border: 2px dashed rgb(167 0 2 / 0.35);
    color: var(--g-ink-soft);
    text-align: center;
  }

  .glowe-hero__slot .glowe-icon {
    inline-size: 44px;
    block-size: 44px;
    color: var(--g-red);
  }

  .glowe-hero__slot p {
    max-inline-size: 32ch;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .glowe-hero__photo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .glowe-hero--split .glowe-hero__content {
    padding-block: 8px 48px;
  }

  .glowe-hero__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 22px;
  }

  .glowe-hero__now {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--g-red);
  }

  .glowe-hero--black .glowe-hero__now {
    color: #fff;
  }

  .glowe-hero__was {
    font-size: 1rem;
    color: var(--g-muted);
  }

  .glowe-hero__content {
    position: relative;
    display: grid;
    justify-items: center;
    padding: clamp(56px, 8vw, 104px) 20px clamp(36px, 4vw, 56px);
    text-align: center;
  }

  .glowe-hero__kicker {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
  }

  .glowe-hero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: clamp(2.6rem, 1rem + 6.5vw, 6.25rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #d8343c;
    text-shadow: 0 0 40px rgb(216 52 60 / 0.25);
    text-wrap: balance;
  }

  .glowe-hero__sub {
    max-inline-size: 46ch;
    margin: 22px 0 30px;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.8);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowe – Hero",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fond",
      "options": [
        { "value": "ivory", "label": "Crème" },
        { "value": "black", "label": "Noir (idéal avec une photo sombre)" }
      ],
      "default": "ivory"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo du masque (facultatif)",
      "info": "Laissez vide pour afficher automatiquement la photo principale du produit. Format carré conseillé."
    },
    {
      "type": "text",
      "id": "promo_end",
      "label": "Fin de la promo",
      "info": "Même date que la barre promo. Après cette date, le titre de marque remplace le titre promo.",
      "default": "2026-12-01 23:59:59 -0500"
    }
  ],
  "presets": [
    {
      "name": "Glowe – Hero"
    }
  ]
}
{% endschema %}
