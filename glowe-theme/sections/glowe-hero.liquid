{% comment %}
  Section contract.
  Full-width black hero with a large glowing red headline and one call to action.
  Shows the promo headline while the promotion runs, the brand headline otherwise.
  An optional background image sits under a dark overlay.
  @example
  <!-- Home page, first section. Choose the LED mask product. -->
{% endcomment %}
{% render 'glowe-styles' %}
{%- liquid
  assign product = section.settings.product
  assign product_url = routes.all_products_collection_url
  if product != blank
    assign product_url = product.url
  endif
  assign promo_active = false
  if section.settings.promo_end != blank
    assign now_s = 'now' | date: '%s' | plus: 0
    assign end_s = section.settings.promo_end | date: '%s' | plus: 0
    if end_s > now_s
      assign promo_active = true
    endif
  endif
-%}
<div class="section section--full-width glowe glowe--tone-black glowe-hero">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        widths: '800, 1200, 1600, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'glowe-hero__bg',
        alt: section.settings.image.alt
    }}
  {%- endif -%}
  <div class="glowe__inner glowe-hero__content">
    {%- if promo_active -%}
      <p class="glowe-hero__kicker">{{ 'glowe.hero.promo_kicker' | t }}</p>
      <h1 class="glowe-hero__title">{{ 'glowe.hero.promo_title' | t }}</h1>
    {%- else -%}
      <p class="glowe-hero__kicker">{{ 'glowe.hero.eyebrow' | t }}</p>
      <h1 class="glowe-hero__title">{{ 'glowe.hero.big_title' | t }}</h1>
    {%- endif -%}
    <p class="glowe-hero__sub">{{ 'glowe.hero.big_sub' | t }}</p>
    <a class="glowe-btn glowe-btn--outline-light" href="{{ product_url }}">{{ 'glowe.hero.shop' | t }}</a>
  </div>
</div>

{% stylesheet %}
  .glowe.glowe-hero {
    position: relative;
    display: grid;
    align-items: center;
    min-block-size: clamp(420px, 62vh, 640px);
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 50% 45%, rgb(167 0 2 / 0.14) 0%, transparent 70%),
      #0a0808;
  }

  .glowe-hero__bg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0.45;
  }

  .glowe-hero__content {
    position: relative;
    display: grid;
    justify-items: center;
    padding: clamp(64px, 10vw, 120px) 20px;
    text-align: center;
  }

  .glowe-hero__kicker {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
  }

  .glowe-hero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: clamp(2.6rem, 1rem + 6.5vw, 6.25rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #d8343c;
    text-shadow: 0 0 40px rgb(216 52 60 / 0.25);
    text-wrap: balance;
  }

  .glowe-hero__sub {
    max-inline-size: 46ch;
    margin: 22px 0 30px;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.8);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowe – Hero",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond (facultatif)",
      "info": "Une photo sombre fonctionne le mieux. Format conseillé : 2400 × 1200 px."
    },
    {
      "type": "text",
      "id": "promo_end",
      "label": "Fin de la promo",
      "info": "Même date que la barre promo. Après cette date, le titre de marque remplace le titre promo.",
      "default": "2026-12-01 23:59:59 -0500"
    }
  ],
  "presets": [
    {
      "name": "Glowe – Hero"
    }
  ]
}
{% endschema %}
