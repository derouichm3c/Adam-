{% doc %}
  Glowe Lab look for Horizon's mobile menu drawer (snippets/header-drawer.liquid):
  a light editorial header with the shop name in spaced capitals and a thin close button,
  large airy links with hairline dividers and a subtle arrow, current page in red.
  Uses a Liquid style tag (not a stylesheet tag) because the brand band shows the shop name.
  Rendered once from the glowe-announcement section, which sits in the header group on every page.

  @example
  {% render 'glowe-drawer-styles' %}
{% enddoc %}
{% style %}
  .header-drawer .menu-drawer {
    --glowe-drawer-band: 72px;
    --glowe-drawer-pad: 28px;

    width: min(88vw, 380px);
    padding-block-start: 0;
    background: #faf5ef;
    color: #111111;
  }

  .header-drawer .menu-drawer::before {
    content: {{ shop.name | upcase | json }};
    display: flex;
    align-items: center;
    flex: none;
    min-block-size: calc(var(--glowe-drawer-band) + var(--safe-area-inset-top, 0px));
    margin-inline: var(--glowe-drawer-pad);
    padding-block-start: var(--safe-area-inset-top, 0px);
    padding-inline-end: 56px;
    border-block-end: 1px solid rgb(17 17 17 / 0.1);
    color: #111111;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.32em;
  }

  .header-drawer .menu-drawer > .menu-drawer__close-button {
    position: absolute;
    inset-block-start: calc(var(--safe-area-inset-top, 0px) + (var(--glowe-drawer-band) - 44px) / 2);
    inset-inline-end: 16px;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border-radius: 50%;
    background: transparent;
    color: #111111;
    transition: background-color 0.2s ease;
  }

  .header-drawer .menu-drawer > .menu-drawer__close-button:hover {
    background: rgb(17 17 17 / 0.06);
  }

  .header-drawer .menu-drawer__navigation {
    margin-block-start: 20px;
  }

  .header-drawer .menu-drawer__menu:not(.menu-drawer__menu--childlist):not(.menu-drawer__menu--grandchildlist) {
    padding-inline: var(--glowe-drawer-pad);
  }

  .header-drawer .menu-drawer__menu > li {
    border-block-end: 1px solid rgb(17 17 17 / 0.07);
  }

  .header-drawer .menu-drawer__menu > li:last-child {
    border-block-end: 0;
  }

  .header-drawer .menu-drawer__menu-item--mainlist {
    min-block-size: 64px;
    padding: 0;
    font-family: var(--font-heading--family);
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #111111;
    transition: color 0.2s ease, transform 0.25s ease;
  }

  .header-drawer .menu-drawer__menu-item--mainlist:not(summary)::after {
    content: '→';
    font-family: var(--font-body--family);
    font-size: 1rem;
    opacity: 0.3;
    transition: opacity 0.2s ease, transform 0.25s ease;
  }

  .header-drawer .menu-drawer__menu-item--mainlist:hover {
    color: #a70002;
  }

  .header-drawer .menu-drawer__menu-item--mainlist:hover::after {
    opacity: 1;
    transform: translateX(4px);
  }

  .header-drawer .menu-drawer__menu-item--mainlist[aria-current='page'],
  .header-drawer .menu-drawer__menu-item--mainlist.menu-drawer__menu-item--active {
    color: #a70002;
  }

  .header-drawer .menu-drawer__menu-item--mainlist[aria-current='page']::after {
    opacity: 1;
  }

  [dir='rtl'] .header-drawer .menu-drawer__menu-item--mainlist:not(summary)::after {
    content: '←';
  }

  .header-drawer .menu-drawer__utility-links {
    margin-block-start: auto;
    padding: 20px var(--glowe-drawer-pad) 28px;
    border-block-start: 1px solid rgb(17 17 17 / 0.1);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-drawer .menu-drawer__menu-item--mainlist,
    .header-drawer .menu-drawer__menu-item--mainlist::after {
      transition: none;
    }
  }
{% endstyle %}
