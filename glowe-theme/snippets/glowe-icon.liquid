{% doc %}
  Renders a decorative Glowe Lab line icon.

  @param {string} name - Icon name: truck, return, lock, chat, check, face, palette, home, gift, spark, clock, shield, heart, leaf, star, arrow
  @param {string} [class] - Extra class names

  @example
  {% render 'glowe-icon', name: 'truck' %}
{% enddoc %}
{%- liquid
  assign icon_class = 'glowe-icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
<svg
  class="{{ icon_class }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3z"/><path d="M14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'return' -%}
      <path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/><path d="M12 14.5v2.5"/>
    {%- when 'chat' -%}
      <path d="M20 12a7.5 7.5 0 0 1-11.2 6.5L4 20l1.5-4.6A7.5 7.5 0 1 1 20 12z"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'face' -%}
      <path d="M12 3c-4 0-6.5 3.2-6.5 7.4 0 4.6 3 9.6 6.5 9.6s6.5-5 6.5-9.6C18.5 6.2 16 3 12 3z"/><path d="M9.2 10.5h.01M14.8 10.5h.01"/><path d="M10 15c1.2.8 2.8.8 4 0"/>
    {%- when 'palette' -%}
      <path d="M12 3a9 9 0 1 0 0 18c1.4 0 2-.9 2-1.8 0-1.3-1-1.7-1-2.9 0-1 .8-1.8 1.9-1.8H17a4 4 0 0 0 4-4C21 6.4 17 3 12 3z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7.2" r="1"/><circle cx="14.5" cy="7.2" r="1"/>
    {%- when 'home' -%}
      <path d="M4 10.5 12 4l8 6.5V20H4z"/><path d="M9.5 20v-5.5h5V20"/>
    {%- when 'gift' -%}
      <rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18M12 9v11"/><path d="M12 9c-1.5-3.5-5.5-3.5-5.5-1.2C6.5 9 9 9 12 9zm0 0c1.5-3.5 5.5-3.5 5.5-1.2C17.5 9 15 9 12 9z"/>
    {%- when 'spark' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'shield' -%}
      <path d="M12 3 5 6v5.5c0 4.4 3 7.9 7 9.5 4-1.6 7-5.1 7-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-6.5 9.5-8"/>
    {%- when 'star' -%}
      <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/>
  {%- endcase -%}
</svg>
